# Backend environment variables for MegaCentrale
NODE_ENV=development
PORT=3000

# Database Configuration (REQUIRED)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=idmegacentral

# JWT Configuration (REQUIRED - Change in production!)
JWT_SECRET=your-jwt-secret-change-this

# MegaCaisse API Configuration (REQUIRED - clé longue et aléatoire, à partager uniquement avec MegaCaisse)
MEGACAISSE_API_KEY=change-this-to-a-long-random-secret

# CORS Configuration (Comma-separated for production)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Email Configuration (SMTP)
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_TEST_MODE=false
